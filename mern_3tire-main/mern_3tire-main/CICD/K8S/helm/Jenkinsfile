pipeline {
    agent any

    environment {
        BACKEND_IMAGE  = "harshajain/backend"
        DOCKERFILE     = "./Dockerfile"
        SONAR_HOST_URL = "http://65.0.129.172:9000"
        HELM_VALUES    = "k8s/backend/backend-chart/values.yaml"
        GIT_REPO       = "https://github.com/jaintpharsha/mern_3tire.git"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('CHECKOUT') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        credentialsId: 'github',
                        url: "${GIT_REPO}"
                    ]]
                ])
            }
        }

        stage('SONARQUBE ANALYSIS') {
            steps {
                dir('./backend') {
                    withCredentials([string(credentialsId: 'backend', variable: 'SONAR_TOKEN')]) {
                        sh "sonar-scanner -Dsonar.host.url=${SONAR_HOST_URL}"
                    }
                }
            }
        }

        stage('DOCKER BUILD') {
            steps {
                script {
                    dir('./backend') {
                        backendImage = docker.build(
                            "${BACKEND_IMAGE}:${env.BUILD_NUMBER}",
                            "--no-cache -f ${DOCKERFILE} ."
                        )
                    }
                }
            }
        }

        stage('TRIVY SCAN') {
            steps {
                sh """
                    trivy image \\
                        --severity LOW,MEDIUM,HIGH \\
                        --exit-code 0 \\
                        --format table \\
                        ${BACKEND_IMAGE}:${env.BUILD_NUMBER}
                """
                sh """
                    trivy image \\
                        --severity CRITICAL \\
                        --exit-code 1 \\
                        --format table \\
                        ${BACKEND_IMAGE}:${env.BUILD_NUMBER}
                """
            }
        }

        stage('PUSH IMAGE') {
            steps {
                script {
                    docker.withRegistry('https://registry.hub.docker.com', 'docker_hub') {
                        backendImage.push("${env.BUILD_NUMBER}")
                        backendImage.push('latest')
                    }
                }
            }
        }

        stage('UPDATE GITOPS REPO') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                    sh """
                        sed -i 's|tag:.*|tag: "${env.BUILD_NUMBER}"|' ${HELM_VALUES}
                    """
                    sh """
                        git config user.email "jenkins@ci.local"
                        git config user.name "Jenkins CI"
                        git add ${HELM_VALUES}
                        git commit -m "ci: update backend image tag to ${env.BUILD_NUMBER}"
                        git push https://${GIT_USER}:${GIT_PASS}@github.com/jaintpharsha/mern_3tire.git HEAD:main
                    """
                }
            }
        }
    }

    post {
        always {
            sh "docker rmi ${BACKEND_IMAGE}:${env.BUILD_NUMBER} || true"
            cleanWs()
        }
    }
}
